DATABASE_URL="postgresql://<user>@localhost:5432/somec_quotation?schema=public"
PORT=3000
# any long random string; tokens are invalid after it changes
JWT_SECRET="change-me"
# token lifetime in seconds (default 12 h)
JWT_EXPIRES_IN_SECONDS=43200
# Server-side only. Never put API keys in the frontend or commit a real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Preferred LLM provider for the assistant, insights and project search. A Groq key (gsk_...) uses
# api.groq.com; an xAI key (xai-...) uses api.x.ai. When set, it wins over OPENAI_API_KEY.
GROK_API_KEY=
# Optional overrides: model (Groq default openai/gpt-oss-120b, xAI default grok-3-mini) and reasoning level (low|medium|high).
GROK_MODEL=
LLM_REASONING=medium
